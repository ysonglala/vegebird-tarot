VEGE_TAROT_LLM_MODE=mock
VEGE_TAROT_LLM_BASE_URL=https://api.openai.com/v1
VEGE_TAROT_LLM_API_KEY=
VEGE_TAROT_LLM_MODEL=gpt-4.1-mini
VEGE_TAROT_LLM_TIMEOUT_MS=60000

# Deep reading via OpenClaw hooks (recommended).
# Keep tokens in deployment env only; never expose them in frontend code.
VEGE_TAROT_OPENCLAW_HOOK_URL=
VEGE_TAROT_OPENCLAW_HOOK_TOKEN=

# Legacy/fallback OpenClaw Control/Gateway settings.
# You may paste a web URL with #token=... here; server.js strips the hash.
VEGE_TAROT_OPENCLAW_URL=
VEGE_TAROT_OPENCLAW_TOKEN=
VEGE_TAROT_OPENCLAW_TIMEOUT_MS=180000
VEGE_TAROT_OPENCLAW_CALLBACK_SECRET=
VEGE_TAROT_PUBLIC_API_BASE=

PORT=8787
